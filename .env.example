# 앱 실행용 설정입니다. Claude Code 계정/모델/과금 설정과 별개입니다.
LINER_MODE=mock
LINER_API_KEY=
LINER_BUDGET_MICRO_USD=0
# live 검색 전체 호출 수 한도(DB 원장 기준, 정수 1 이상). mock에서는 쓰지 않는다.
LINER_MAX_CALLS=0
DEMO_ORIGIN=http://127.0.0.1:4310
API_PORT=4311
DATABASE_PATH=.data/career-evidence.sqlite
BROWSER_APPLY_ENABLED=false
# LINER_MODE=live는 LINER_API_KEY·LINER_MAX_CALLS(1 이상)·LINER_BUDGET_MICRO_USD(0 초과)가 모두 있어야 시작합니다.

# 대화 수정 provider: mock(기본) 또는 liner(Liner Router API, 유료). liner는 LINER_API_KEY와 아래 대화 전용 한도가 모두 있어야 시작합니다.
# 대화 내용(메시지·확정 경력·공고)이 Liner로 전송됩니다(최대 60일 보관, 해외 AI 제공사 경유 가능). 이메일·전화번호는 가려서 보냅니다.
CHAT_MODE=mock
# 대화 호출 수 한도(DB 원장 기준, 정수 1 이상)와 예산(micro-USD). 검색 한도와 따로 센다.
LINER_CHAT_MAX_CALLS=0
LINER_CHAT_BUDGET_MICRO_USD=0
# 라우팅: cost | balanced(기본) | quality
LINER_CHAT_ROUTING=balanced
# 기본 이력서 보완 대화 실행 방식: staged(기본, 규칙 점검 → AI 점검 / 초안 → 근거 검토, 턴당 호출 1~2건) | single(비교용, 턴당 1건)
SUPPLEMENT_PIPELINE=staged
