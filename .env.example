# 앱 실행용 설정입니다. Claude Code 계정/모델/과금 설정과 별개입니다.
# 복사해서 쓰세요: cp .env.example .env
# 키 외의 값은 모두 채워 두었습니다. 그대로 실행하면 mock(키 불필요)이고,
# Liner API로 실행하려면 LINER_API_KEY를 넣고 CHAT_MODE=liner(그리고 필요하면 LINER_MODE=live)로 바꾸면 됩니다.

# ── Liner API 키(직접 넣기, 코드·커밋에 적지 않음) ──
LINER_API_KEY=

# ── 공고 검색: mock(합성 공고) | live(Liner Web Search, 유료) ──
LINER_MODE=mock
# live 검색 전체 호출 수 한도(DB 원장 기준, 정수 1 이상). mock에서는 쓰지 않는다.
LINER_MAX_CALLS=20
# live 검색 예산(micro-USD, 1,000,000 = $1). 끝난 호출은 확인된 비용, 진행 중·결과 불명은 예약으로 센다.
LINER_BUDGET_MICRO_USD=2000000

# ── AI 대화: mock(규칙 기반 합성 응답) | liner(Liner Router API, 유료) ──
# 이력서 읽기(검토 초안)·HR 점검·문장 추천·JD 점검·맞춤 수정에 쓴다.
# 대화 내용(이력서·메시지·확정 경력·공고)이 Liner로 전송됩니다(최대 60일 보관, 해외 AI 제공사 경유 가능). 이메일·전화번호는 가려서 보냅니다.
CHAT_MODE=mock
# 대화 호출 수 한도(DB 원장 기준, 정수 1 이상)와 예산(micro-USD, $5). 검색 한도와 따로 센다.
# 참고: 실제 이력서 한 번의 전체 흐름(읽기 → 점검·추천 → JD 점검 → 맞춤 수정)이 8~11건, 약 $0.6이었다(2026-11-24).
LINER_CHAT_MAX_CALLS=20
LINER_CHAT_BUDGET_MICRO_USD=5000000
# 라우팅: cost | balanced | quality(결과 품질 우선, 시연에서 쓴 값)
LINER_CHAT_ROUTING=quality
# 기본 이력서 보완 대화 실행 방식: staged(규칙 점검 → AI 점검 / 초안 → 근거 검토, 턴당 호출 1~2건) | single(비교용, 턴당 1건)
SUPPLEMENT_PIPELINE=staged

# ── 로컬 실행(바꾸지 않아도 됩니다) ──
# 웹 주소는 고정입니다(웹·확장·API가 이 주소로 맞춰져 있음).
DEMO_ORIGIN=http://127.0.0.1:4310
API_PORT=4311
DATABASE_PATH=.data/career-evidence.sqlite
OBJECT_DIR=.data/objects
# 외부 채용 사이트 브라우저 제출은 아직 없다(true면 시작하지 않음). 자체 테스트 폼 제출은 이 값과 무관하다.
BROWSER_APPLY_ENABLED=false
