{
  "name": "career-evidence-claude-starter",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Career Evidence 통합 개발 자료 v0.7. 이력서 중심 제품 명세와 Claude Code 구현 기반.",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11 <13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs apps/extension/guard.test.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:api": "node --env-file-if-exists=.env apps/api/src/main.ts",
    "worker": "node --env-file-if-exists=.env apps/worker/src/main.ts",
    "db:check": "node scripts/db-check.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "check:contracts": "python3 scripts/check_contracts.py",
    "check": "node scripts/check.mjs",
    "check:integration": "node scripts/check-integration.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "mammoth": "1.13.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.7.284",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
